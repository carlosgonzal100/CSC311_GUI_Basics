<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Sphere?>

<VBox fx:id="mainPane" alignment="CENTER" prefHeight="502.0" prefWidth="390.0" spacing="20.0" stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="org.example.csc311_gui_basics.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <ImageView fx:id="image_2" fitHeight="44.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true" translateX="-75.0" translateY="155.0" />
   <Button fx:id="yesButton" mnemonicParsing="false" onAction="#incrementYesCounter" rotate="180.0" text="YES" translateX="125.0" translateY="75.0" />
   <Sphere fx:id="sphere_1" radius="20.0" translateX="-75.0" translateY="45.0" />
   <Label fx:id="yesCounter" rotate="180.0" text="0" translateX="125.0" />
   <Label fx:id="questionText" rotate="25.0" styleClass="question-label" stylesheets="@style.css" text="I am Carlos Gonzalez?" translateY="20.0" />
   <Label fx:id="nameText" alignment="CENTER" ellipsisString="" prefHeight="46.0" prefWidth="239.0" rotate="25.0" styleClass="name-label" text="Carlos Gonzalez" textAlignment="CENTER" wrapText="true" />
   <Label fx:id="noCounter" text="0" translateX="-125.0" translateY="10.0" />
   <Button fx:id="noButton" mnemonicParsing="false" onAction="#incrementNoCounter" text="NO" translateX="-125.0" translateY="-5.0" />
   <Sphere fx:id="sphere_2" radius="20.0" translateX="75.0" translateY="-70.0" />
   <ImageView fx:id="image_1" fitHeight="44.0" fitWidth="44.0" pickOnBounds="true" preserveRatio="true" translateX="75.0" translateY="-130.0" />
</VBox>
