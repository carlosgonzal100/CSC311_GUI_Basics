<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="mainPane" alignment="CENTER" prefHeight="237.0" prefWidth="352.0" spacing="20.0" stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/26" fx:controller="org.example.csc311_gui_basics.HelloController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <Button fx:id="yesButton" mnemonicParsing="false" onAction="#incrementYesCounter" rotate="180.0" text="YES" translateX="125.0" translateY="25.0" />
   <Label fx:id="yesCounter" rotate="180.0" text="0" translateX="125.0" translateY="10.0" />
   <Label fx:id="questionText" rotate="25.0" styleClass="question-label" stylesheets="@style.css" text="I am Carlos Gonzalez?" translateY="20.0" />
   <Label fx:id="nameText" alignment="CENTER" ellipsisString="" prefHeight="46.0" prefWidth="239.0" rotate="25.0" styleClass="name-label" text="Carlos Gonzalez" textAlignment="CENTER" wrapText="true" />
   <Label fx:id="noCounter" text="0" translateX="-125.0" translateY="-10.0" />
   <Button fx:id="noButton" mnemonicParsing="false" onAction="#incrementNoCounter" text="NO" translateX="-125.0" translateY="-25.0" />
</VBox>
